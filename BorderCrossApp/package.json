{
  "name": "garita-inteligente",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android --port 8092",
    "ios": "react-native run-ios --port 8092",
    "predev:ios": "lsof -ti tcp:8092 | xargs kill -9 || true",
    "dev:ios": "concurrently \"yarn start:metro\" \"yarn ios\"",
    "dev:android": "concurrently \"yarn start:metro\" \"yarn android\"",
    "start": "react-native start --port 8092",
    "start:metro": "react-native start --port 8092 --reset-cache",
    "lint": "eslint .",
    "test": "jest",
    "postinstall": "cd ios && pod install",
    "setup-cron": "node scripts/setup-cron.js",
    "deploy-functions": "supabase functions deploy",
    "test-scraper": "supabase functions invoke scrape-traffic-data"
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.80.1",
    "@react-navigation/bottom-tabs": "^7.4.2",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/stack": "^7.4.2",
    "@supabase/supabase-js": "^2.51.0",
    "react": "19.1.0",
    "react-native": "0.80.1",
    "react-native-config": "^1.5.5",
    "react-native-dotenv": "^3.4.11",
    "react-native-geolocation-service": "^5.3.1",
    "react-native-gesture-handler": "^2.27.1",
    "react-native-get-random-values": "^1.11.0",
    "react-native-gifted-chat": "^2.8.1",
    "react-native-keyboard-controller": "^1.17.5",
    "react-native-maps": "^1.24.5",
    "react-native-reanimated": "^3.18.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.12.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-vector-icons": "^10.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "19.0.0",
    "@react-native-community/cli-platform-android": "19.0.0",
    "@react-native-community/cli-platform-ios": "19.0.0",
    "@react-native/babel-preset": "0.80.1",
    "@react-native/eslint-config": "0.80.1",
    "@react-native/metro-config": "0.80.1",
    "@react-native/typescript-config": "0.80.1",
